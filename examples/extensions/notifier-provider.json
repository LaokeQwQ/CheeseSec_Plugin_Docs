{
  "api_version": "crp.cheesewaf.io/notifier/v1",
  "provider_id": "official-teams-webhook-1.0.0",
  "type": "teams_webhook",
  "version": "1.0.0",
  "namespace": "official/notifier-teams",
  "source": "local-index",
  "source_root": "vendor-root-v1",
  "host_compatibility": { "min": "0.4.5", "max": "0.5" },
  "config_schema": {
    "dialect": "cheesewaf-notifier-config/v1",
    "fields": [
      { "name": "tenant", "kind": "string", "required": false, "max_length": 128 }
    ]
  },
  "secret_fields": ["webhook_ref"],
  "endpoint_templates": [
    {
      "name": "notify",
      "url_template": "https://example.webhook.office.com/webhookb2/notify",
      "method": "POST",
      "egress_owner": "cheesewaf-core",
      "variables": []
    }
  ],
  "capabilities": ["alert_delivery", "test_delivery"],
  "publication": { "status": "loadable", "installable": false, "crp_binding": "descriptor-only" }
}
